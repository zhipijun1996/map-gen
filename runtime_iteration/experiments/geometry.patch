+func geometry_plan(occupied: Array,key: Array=[])->Array:
+	if key.is_empty():key=placement_state(occupied)
+	if geometry_cache.has(key):return geometry_cache[key]
+	var groups: Dictionary={}
+	for i in range(occupied.size()):
+		for pid in occupied[i].ports:
+			var port: Dictionary=occupied[i].ports[pid]
+			if not groups.has(port.world2):groups[port.world2]=[]
+			groups[port.world2].append([i,pid,port])
+	var connections: Array=[];var frontier: Array=[]
+	for group in groups.values():
+		if group.size()==2 and GEO.matching(group[0][2],group[1][2]):
+			connections.append([group[0][0],group[0][1],group[1][0],group[1][1]])
+			if occupied[group[0][0]].id!=occupied[group[1][0]].id:continue
+		for entry in group:
+			var joined:=false
+			for other in group:
+				if occupied[entry[0]].id!=occupied[other[0]].id and GEO.matching(entry[2],other[2]):joined=true;break
+			if not joined:frontier.append([entry[0],entry[1]])
+	var plan: Array=[connections,frontier]
