+	for pair in local_graph[0]:edges.append([item.id+pair[0],item.id+pair[1]])
+	for suffix in local_graph[1]:rewards.append(item.id+suffix)
+	var result: Array=[edges,rewards]
+	if prefix_ring.size()<1024:prefix_ring.append(key)
+	else:
+		prefix_cache.erase(prefix_ring[prefix_cursor])
